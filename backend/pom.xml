<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.nabd</groupId>
  <artifactId>hms-backend</artifactId>
  <version>0.1.0</version>
  <name>Nabd HMS Backend</name>

  <properties>
    <!-- PLT-032: Boot 4.1 (3.x OSS support ended 2026-06-30, docs/adr/0017-spring-boot-upgrade.md), Java 21.
         Testcontainers comes from the Boot BOM (2.0.x; OPS-031 needs >= 1.21 for Docker Engine 29). -->
    <java.version>21</java.version>
    <!-- S10: tests that document REAL unfixed defects stay in the tree but are not run by default (CONTEXT.md lists them).
         Run them with: mvn test -Dknown.defect.tags= -->
    <known.defect.tags>known-defect-ACC-002 | known-defect-ACC-003 | known-defect-ACC-004 | known-defect-FIN-003 | known-defect-OPS-004 | known-defect-OPS-007 | known-defect-OPS-034 | known-defect-PLT-044 | known-defect-PLT-038 | known-defect-IDC-001 | known-defect-CLN-004 | known-defect-CLN-005 | known-defect-OPS-012 | known-defect-OPS-042 | known-defect-OPS-020 | known-defect-PLT-009</known.defect.tags>
    <pit.history>${project.build.directory}/pit-history.bin</pit.history>
  </properties>

  <dependencies>
    <!--
      Logging: spring-boot-starter-web pulls in spring-boot-starter-logging, whose engine is
      Logback (ch.qos.logback:logback-classic), not Log4j — deliberately kept that way. Log4j's
      CVE history (Log4Shell, CVE-2021-44228, lived in log4j-core's message-lookup substitution)
      is categorically worse than Logback's; the only log4j jars on the classpath at all are
      log4j-api and log4j-to-slf4j, a compatibility bridge that redirects any dependency logging
      via the log4j2 API into this same Logback engine — log4j-core itself, where Log4Shell
      actually lived, is never pulled in. `mvn dependency:tree | grep -i log4j-core` should
      always come back empty; if some future dependency drags it in, exclude it rather than let
      two logging engines run side by side.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- OPS-034: spec generated from the controllers. Endpoints are off unless springdoc.api-docs.enabled=true (application.yml). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>3.1.1</version>
    </dependency>
    <!-- OPS-025: health/readiness + Prometheus metrics (management port only) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- OPS-025: @WithSpan is only an annotation; the OpenTelemetry Java agent in the image turns it into a span.
         Keep the version equal to the agent version in the Dockerfile. -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-instrumentation-annotations</artifactId>
      <version>2.9.0</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <!-- OPS-016: compile scope for PGConnection.getNotifications (relay LISTEN) -->
    </dependency>
    <!-- Argon2PasswordEncoder delegates to Bouncy Castle; not pulled in transitively -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.78.1</version>
    </dependency>
    <!-- ACC-028: per-country phone validation + E.164 (no transitive deps; nothing in the tree parses phone numbers) -->
    <dependency>
      <groupId>com.googlecode.libphonenumber</groupId>
      <artifactId>libphonenumber</artifactId>
      <version>9.0.30</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- OPS-013: one execution per job across replicas (lock table: V1540__shedlock.sql) -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
      <version>7.10.1</version>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
      <version>7.10.1</version>
    </dependency>
    <!-- PLT-008: Valkey client (Spring Data Redis over Lettuce), configured only by com.nabd.hms.common.valkey -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- PLT-032: Boot 4 moved TestRestTemplate (ApiTestBase) into its own module -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- PLT-008: Redis 6.2 binary as the Valkey stand-in for tests (no Valkey image here); see ValkeyTestSupport -->
    <dependency>
      <groupId>com.github.codemonstur</groupId>
      <artifactId>embedded-redis</artifactId>
      <version>1.4.3</version>
      <scope>test</scope>
    </dependency>
    <!--
      API tests exercise real business rules (RLS tenant isolation, lockout backoff, session
      reuse-detection) that live entirely in SQL — mocking the repository layer would test nothing
      real, as today's session proved catching three live bugs only visible against real Postgres.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- OPS-033: module-boundary checks (ArchitectureRulesTest); test scope only. It also brings ArchUnit 1.3.1
         (com.tngtech.archunit:archunit), which PLT-028's ClinicClockUsageTest uses: no separate ArchUnit dependency. -->
    <!-- PLT-033: @NamedInterface on iam.api / organization.api (annotations only) -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
      <version>2.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-core</artifactId>
      <version>2.1.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- OPS-020: PLT-052's column tiers ship in the jar for CacheKeyPolicy (classpath:db/classification.yaml) -->
      <resource>
        <directory>../db</directory>
        <targetPath>db</targetPath>
        <includes>
          <include>classification.yaml</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${known.defect.tags}</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- OPS-032: nightly mutation testing, run with -Ppit org.pitest:pitest-maven:mutationCoverage -->
      <id>pit</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.17.1</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.1</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.nabd.hms.clinical.RxSafetyChecks*</param>
                <param>com.nabd.hms.clinical.AllergyDrugClasses*</param>
                <param>com.nabd.hms.clinical.PrescriptionService*</param>
                <param>com.nabd.hms.billing.CheckoutService*</param>
                <!-- FIN-010: the pure tax rules (engine, jurisdiction adapters, credit-note arithmetic); gate: >= 85% per class in ci/quality-gates.json -->
                <param>com.nabd.hms.billing.tax.RuleBasedTaxEngine*</param>
                <param>com.nabd.hms.billing.tax.TaxEngine*</param>
                <param>com.nabd.hms.billing.tax.IndiaGst*</param>
                <param>com.nabd.hms.billing.tax.FlatVat*</param>
                <param>com.nabd.hms.billing.CreditNoteMath*</param>
              </targetClasses>
              <outputFormats><param>XML</param></outputFormats>
              <timestampedReports>false</timestampedReports>
              <withHistory>true</withHistory>
              <historyInputFile>${pit.history}</historyInputFile>
              <historyOutputFile>${pit.history}</historyOutputFile>
              <threads>2</threads>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
