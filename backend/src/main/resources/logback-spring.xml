<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <conversionRule conversionWord="mask" converterClass="com.nabd.hms.common.PhiMaskingConverter"/>

  <!-- OPS-028: JSON lines in every profile (timestamp, level, logger, traceId, tenantId, staffId, reasonCode); message and stack trace masked -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="com.nabd.hms.common.PhiJsonEncoder"/>
  </appender>

  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
