{
 "title": "Comms Gateway",
 "uid": "comms-gateway",
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Send outcomes by outcome",
   "targets": [
    {
     "expr": "sum by (outcome) (rate(comms_send_total[5m]))"
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Webhook ack latency p95",
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"comms-gateway\",uri=~\"/webhooks.*\"}[5m])))"
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Consumer lag (seconds)",
   "targets": [
    {
     "expr": "max(consumer_lag_seconds{group=\"comms\"})"
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Dead letters (5 m)",
   "targets": [
    {
     "expr": "sum(increase(consumer_dlq_total{group=\"comms\"}[5m]))"
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Send SLO burn rate 1 h",
   "targets": [
    {
     "expr": "(sum(rate(comms_send_total{outcome!=\"sent\"}[1h])) / sum(rate(comms_send_total[1h]))) / 0.01"
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   }
  }
 ]
}