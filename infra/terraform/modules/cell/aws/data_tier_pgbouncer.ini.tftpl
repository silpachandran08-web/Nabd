; OPS-055: rendered by Terraform, written to /etc/pgbouncer/pgbouncer.ini at boot. No secrets here (userlist.txt is written from Secrets Manager).
[databases]
nabd = host=${db_host} port=5432 dbname=nabd

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432
pool_mode = transaction
; >= 1.21 only: protocol-level prepared statements survive transaction pooling. If this ever has to go to 0, set prepareThreshold=0 in the JDBC URL.
max_prepared_statements = 200
max_client_conn = ${max_client}
default_pool_size = ${app_pool}
reserve_pool_size = 0
query_wait_timeout = 5
server_reset_query =
ignore_startup_parameters = extra_float_digits,options

auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt
auth_user = pgbouncer_auth
auth_query = SELECT username, password FROM pgbouncer.get_auth($1)
admin_users =
stats_users = pgbouncer_stats

; shortcut: client TLS uses a boot-time self-signed cert (clients use sslmode=require), upgrade to an internal CA with verify-full
client_tls_sslmode = require
client_tls_key_file = /etc/pgbouncer/client.key
client_tls_cert_file = /etc/pgbouncer/client.crt
server_tls_sslmode = verify-full
server_tls_ca_file = /etc/pgbouncer/rds-ca-bundle.pem

[users]
nabd_app = pool_size=${app_pool}
nabd_reports = pool_size=${reports_pool}
