# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.production holds only the public API base URL, never a secret — tracked so a fresh
# checkout deploys pointed at the right backend without a manual Vercel dashboard step.
!.env.production
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
