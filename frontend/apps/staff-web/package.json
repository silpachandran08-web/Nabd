{
  "name": "staff-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && stylelint \"app/**/*.css\"",
    "check:permissions": "node scripts/check-permission-rendering.mjs",
    "check:raw-api": "node scripts/check-raw-api.mjs",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/unit/*.test.mjs",
    "test": "npm run -s test:unit"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-kannada": "5.3.0",
    "@fontsource/noto-sans-telugu": "5.3.0",
    "@nabd/api-client": "workspace:*",
    "@nabd/domain": "workspace:*",
    "@nabd/i18n": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "msw": "2.7.0",
    "stylelint": "16.26.1",
    "typescript": "^5"
  }
}
