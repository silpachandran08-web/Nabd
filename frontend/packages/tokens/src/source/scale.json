{
  "space": { "2": "2px", "4": "4px", "8": "8px", "10": "10px", "12": "12px", "16": "16px", "20": "20px", "24": "24px", "32": "32px", "40": "40px", "48": "48px", "64": "64px" },
  "radius": { "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "20px", "2xl": "28px" },
  "fs": { "xs": "12px", "sm": "13px", "md": "14px", "base": "16px", "lg": "18px", "xl": "22px", "2xl": "28px" },
  "motion": { "dur-base": "180ms", "ease-standard": "cubic-bezier(0.2, 0, 0.2, 1)" },
  "layout": { "topbar-h": "64px", "touch-min": "44px" },
  "z": { "base": 0, "sticky": 10, "nav": 20, "dropdown": 30, "overlay": 40, "modal": 50, "toast": 60, "lock": 100 },
  "breakpoints": {
    "bp-phone": { "query": "(max-width: 430px)", "px": 430 },
    "bp-tablet-portrait": { "query": "(max-width: 768px)", "px": 768 },
    "bp-tablet": { "query": "(max-width: 1024px)", "px": 1024 },
    "bp-desktop": { "query": "(min-width: 1440px)", "px": 1440 }
  },
  "aliases": {
    "_note": "Prototype nb.css names mapped onto the --nb-* tokens (the prototype file itself is not in this repository).",
    "acc": "accent-500", "s1": "surface-1", "s2": "surface-2", "s3": "surface-3",
    "tx": "text-primary", "tx2": "text-secondary", "tx3": "text-tertiary", "tx4": "text-disabled"
  },
  "contrast": {
    "_note": "[foreground, background, min ratio]. Body text >= 4.5, large/UI >= 3. A background that is semi-transparent is composited over surface-1.",
    "text": [
      ["text-primary", "bg-root"], ["text-primary", "bg-canvas"], ["text-primary", "surface-1"], ["text-primary", "surface-2"], ["text-primary", "surface-3"],
      ["text-secondary", "bg-root"], ["text-secondary", "bg-canvas"], ["text-secondary", "surface-1"], ["text-secondary", "surface-2"], ["text-secondary", "surface-3"],
      ["text-tertiary", "bg-root"], ["text-tertiary", "bg-canvas"], ["text-tertiary", "surface-1"], ["text-tertiary", "surface-2"], ["text-tertiary", "surface-3"],
      ["accent-500", "surface-1"], ["accent-500", "accent-tint"], ["on-accent", "accent-500"],
      ["danger-500", "danger-tint"], ["ok-500", "ok-tint"], ["success-500", "success-tint"], ["warn-500", "warn-tint"], ["info-500", "info-tint"], ["sync-500", "sync-tint"], ["urgent-500", "urgent-tint"]
    ],
    "ui": [
      ["focus-ring", "bg-root"], ["focus-ring", "surface-1"], ["focus-ring", "surface-3"]
    ]
  }
}
