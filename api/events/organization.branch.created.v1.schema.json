{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:organization.branch.created.v1",
  "title": "organization.branch.created.v1",
  "description": "An owner added a branch: a new clinic (tenantId) under the same owner, brand and region went live, with its configuration copied from sourceTenantId (PLT-022). Ids only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "ownerId",
    "brandId",
    "sourceTenantId",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ownerId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "brandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sourceTenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "ownerId": "22222222-2222-4222-8222-222222222222",
      "brandId": "33333333-3333-4333-8333-333333333333",
      "sourceTenantId": "44444444-4444-4444-8444-444444444444",
      "version": 1
    }
  ]
}
