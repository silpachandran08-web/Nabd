{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:scheduling.doctor_status.changed.v1",
  "title": "scheduling.doctor_status.changed.v1",
  "description": "A doctor's session state changed (in, paused, out): start, pause, resume, end, or the implicit start at the first in_consult (ACC-015).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "doctorId",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "doctorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "doctorId": "22222222-2222-4222-8222-222222222222",
      "status": "available",
      "version": 1
    }
  ]
}
