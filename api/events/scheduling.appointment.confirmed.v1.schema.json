{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:scheduling.appointment.confirmed.v1",
  "title": "scheduling.appointment.confirmed.v1",
  "description": "The patient confirmed the appointment, e.g. with the Confirm button of a T-24 h / T-2 h reminder (COM-043, through ACC-041). Fanned out to the desk calendar and arrivals in real time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "appointmentId", "source", "version"],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "appointmentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source": { "type": "string", "enum": ["whatsapp_button"] },
    "version": { "type": "integer", "minimum": 1 }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "appointmentId": "33333333-3333-4333-8333-333333333333",
      "source": "whatsapp_button",
      "version": 1
    }
  ]
}
