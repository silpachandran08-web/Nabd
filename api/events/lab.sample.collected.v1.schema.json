{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:lab.sample.collected.v1",
  "title": "lab.sample.collected.v1",
  "description": "Samples were collected for a lab order. Triggers sample tracking and updates the order status to partially_collected or collected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "orderId",
    "sampleIds",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "orderId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sampleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "minItems": 1,
      "description": "The collected sample UUIDs."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "orderId": "55555555-5555-4555-8555-555555555555",
      "sampleIds": [
        "66666666-6666-4666-8666-666666666666",
        "77777777-7777-4777-8777-777777777777"
      ],
      "version": 1
    }
  ]
}
