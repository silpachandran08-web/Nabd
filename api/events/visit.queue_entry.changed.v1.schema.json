{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:visit.queue_entry.changed.v1",
  "title": "visit.queue_entry.changed.v1",
  "description": "A queue entry changed status or priority, or its consult was extended.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "entryId",
    "doctorId",
    "queueDate",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entryId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "doctorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "queueDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "fromStatus": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "priority": {
      "type": "boolean"
    },
    "orderReason": {
      "type": "string",
      "enum": ["priority", "booked_on_time", "interleave", "reserved_slot"],
      "description": "ACC-012: why the call-next policy called this entry (set on a call-next move only)."
    },
    "extendedMinutes": {
      "type": "integer",
      "enum": [5, 10, 15],
      "description": "ACC-015: the consult was extended by this many minutes (status unchanged)."
    },
    "fromDoctorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "ACC-022: the entry was reassigned from this doctor to doctorId."
    },
    "newToken": {
      "type": "integer",
      "minimum": 1,
      "description": "ACC-022: the token the patient now holds after a reassign."
    },
    "previousToken": {
      "type": "integer",
      "minimum": 1,
      "description": "ACC-022: the token before the reassign (shown as 'was T-9')."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "entryId": "44444444-4444-4444-8444-444444444444",
      "doctorId": "22222222-2222-4222-8222-222222222222",
      "queueDate": "2026-10-20",
      "status": "waiting",
      "fromStatus": "checked_in",
      "version": 1
    }
  ]
}
