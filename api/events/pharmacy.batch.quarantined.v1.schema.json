{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:pharmacy.batch.quarantined.v1",
  "title": "pharmacy.batch.quarantined.v1",
  "description": "A stock batch was taken off sale (status quarantined, never picked): by a pharmacist, by the nightly pass once its expiry date has passed, or when a customer return lands in an expired batch. A reason code only, never the free-text note, an item name or a patient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "batchId",
    "reason",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "batchId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "reason": {
      "type": "string",
      "enum": ["expired", "damaged", "other"]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "batchId": "66666666-6666-4666-8666-666666666666",
      "reason": "expired",
      "version": 1
    }
  ]
}
