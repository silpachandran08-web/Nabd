{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:lab.order.placed.v1",
  "title": "lab.order.placed.v1",
  "description": "A doctor placed a lab order (subject = the order). Ids, priority and a count only: no test name. The lab worklist refetches.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "orderId",
    "patientRef",
    "priority",
    "testCount",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "orderId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "patientRef": {
      "type": "string",
      "description": "The patient's opaque reference (PatientRefs), never the patient id.",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "priority": {
      "type": "string",
      "enum": [
        "routine",
        "urgent",
        "stat"
      ]
    },
    "testCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Tests the lab performs for this order (a panel counts as its tests)."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "orderId": "55555555-5555-4555-8555-555555555555",
      "patientRef": "pr_3f9a1c2b7d",
      "priority": "stat",
      "testCount": 4,
      "version": 1
    }
  ]
}
