{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:pharmacy.stock.batch_changed.v1",
  "title": "pharmacy.stock.batch_changed.v1",
  "description": "One batch of a pharmacy item changed quantity (receipt, dispense, return, adjustment or opening balance). onHand is the item's total after the change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "itemId",
    "batchId",
    "delta",
    "kind",
    "onHand",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "itemId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "batchId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "delta": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000,
      "description": "Signed change of the batch."
    },
    "kind": {
      "type": "string",
      "enum": [
        "adjustment",
        "dispense",
        "restock",
        "receipt",
        "sale",
        "return_in",
        "return_out",
        "write_off",
        "transfer",
        "opening"
      ]
    },
    "onHand": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "itemId": "33333333-3333-4333-8333-333333333333",
      "batchId": "44444444-4444-4444-8444-444444444444",
      "delta": -5,
      "kind": "dispense",
      "onHand": 37,
      "version": 1
    }
  ]
}
