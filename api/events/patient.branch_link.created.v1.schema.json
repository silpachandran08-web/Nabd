{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:patient.branch_link.created.v1",
  "title": "patient.branch_link.created.v1",
  "description": "A patient of this clinic was linked at the desk to the same person's record at a sibling branch of the brand (PLT-024); subject = this clinic's patient. Ids only: never a name, phone, date of birth or the other clinic's patient id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "patientId",
    "linkedTenantId",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "patientId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "linkedTenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The sibling branch (a clinic of the same brand and region)."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "patientId": "33333333-3333-4333-8333-333333333333",
      "linkedTenantId": "22222222-2222-4222-8222-222222222222",
      "version": 1
    }
  ]
}
