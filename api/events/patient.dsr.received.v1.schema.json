{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:patient.dsr.received.v1",
  "title": "patient.dsr.received.v1",
  "description": "A data-subject request (access/export, correction or erasure) was received from WhatsApp, the desk or patient-web (PLT-047, DsrService.create); subject = the request. Ids, the type and the due date only: never who asked or about whom. Consumers core.realtime (owner's privacy queue) and control-plane/support (DPO queue): log-only handlers until they exist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "requestId",
    "type",
    "dueAt",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "access",
        "correction",
        "erasure"
      ]
    },
    "dueAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "requestId": "22222222-2222-4222-8222-222222222222",
      "type": "access",
      "dueAt": "2027-06-12T09:30:00Z",
      "version": 1
    }
  ]
}
