{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:reporting.export.created.v1",
  "title": "reporting.export.created.v1",
  "description": "A report from the reports library was exported to Excel, CSV or PDF (ADM-047, ReportLibraryService.export); subject = the export. Ids, the report key, the format and the row count only: never a filter value, a name or a row. The same export is in the audit log with its filters. Consumer core audit: log-only handler until it exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "exportId", "reportId", "actor", "format", "rows", "version"],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "exportId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "reportId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$", "description": "The report key, e.g. leakage, takings." },
    "actor": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The staff member who exported."
    },
    "format": { "type": "string", "enum": ["csv", "xlsx", "pdf"] },
    "rows": { "type": "integer", "minimum": 0 },
    "version": { "type": "integer", "minimum": 1, "description": "Outbox id of this event: monotonic per aggregate." }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "exportId": "22222222-2222-4222-8222-222222222222",
      "reportId": "leakage",
      "actor": "33333333-3333-4333-8333-333333333333",
      "format": "xlsx",
      "rows": 42,
      "version": 1
    }
  ]
}
