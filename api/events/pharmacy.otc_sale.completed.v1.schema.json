{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:pharmacy.otc_sale.completed.v1",
  "title": "pharmacy.otc_sale.completed.v1",
  "description": "A counter (OTC) sale was invoiced and its stock issued (PHL-019). Ids, the number of lines and the invoice total only: never an item name or a customer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "invoiceId",
    "lineCount",
    "totalMinor",
    "currency",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "invoiceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "lineCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "totalMinor": {
      "type": "integer"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "invoiceId": "33333333-3333-4333-8333-333333333333",
      "lineCount": 3,
      "totalMinor": 35000,
      "currency": "INR",
      "version": 1
    }
  ]
}
