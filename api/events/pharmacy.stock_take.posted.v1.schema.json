{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:pharmacy.stock_take.posted.v1",
  "title": "pharmacy.stock_take.posted.v1",
  "description": "A stock-take session was posted: its variances became adjustment movements (one per variant batch) and the session is locked. value is the net variance at purchase rate, in the clinic's currency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "stockTakeId",
    "variances",
    "value",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "stockTakeId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "variances": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Number of batches adjusted."
    },
    "value": {
      "type": "number",
      "minimum": -1000000000000,
      "maximum": 1000000000000,
      "description": "Net variance value (sum of delta x purchase rate; a batch without a rate counts 0)."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "stockTakeId": "55555555-5555-4555-8555-555555555555",
      "variances": 3,
      "value": -37.5,
      "version": 1
    }
  ]
}
