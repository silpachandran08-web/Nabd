{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:organization.config.changed.v1",
  "title": "organization.config.changed.v1",
  "description": "A clinic setting changed (key only, never the value).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "configKey",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "configKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,63}$"
    },
    "status": {
      "type": "string",
      "const": "updated"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "configKey": "session.idle_lock_minutes",
      "status": "updated",
      "version": 1
    }
  ]
}
