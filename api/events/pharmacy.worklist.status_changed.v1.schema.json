{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:pharmacy.worklist.status_changed.v1",
  "title": "pharmacy.worklist.status_changed.v1",
  "description": "A worklist entry changed status: claimed (in_progress), billed at checkout (partially_dispensed, dispensed) or past its Rx validity (expired). Subject = the entry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "entryId",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entryId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "partially_dispensed",
        "dispensed",
        "cancelled",
        "expired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "entryId": "55555555-5555-4555-8555-555555555555",
      "status": "in_progress",
      "version": 2
    }
  ]
}
