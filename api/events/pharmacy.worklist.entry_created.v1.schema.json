{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:pharmacy.worklist.entry_created.v1",
  "title": "pharmacy.worklist.entry_created.v1",
  "description": "A signed prescription with in-house lines entered an In-house clinic's dispensing worklist (once per prescription; subject = the entry). Ids only: the screen refetches.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "entryId",
    "prescriptionId",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entryId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "prescriptionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "entryId": "55555555-5555-4555-8555-555555555555",
      "prescriptionId": "33333333-3333-4333-8333-333333333333",
      "version": 1
    }
  ]
}
