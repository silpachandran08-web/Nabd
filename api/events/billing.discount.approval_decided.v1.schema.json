{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:billing.discount.approval_decided.v1",
  "title": "billing.discount.approval_decided.v1",
  "description": "The owner approved or rejected a discount approval request (FIN-018), in the app or by PIN at the desk.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "approvalId", "decision", "version"],
  "properties": {
    "tenantId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "approvalId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "decision": {"type": "string", "enum": ["approved", "rejected"]},
    "version": {"type": "integer", "minimum": 1, "description": "Outbox id of this event: monotonic per aggregate."}
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "approvalId": "66666666-6666-4666-8666-666666666666",
      "decision": "approved",
      "version": 2
    }
  ]
}
