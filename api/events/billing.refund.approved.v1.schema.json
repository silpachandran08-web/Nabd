{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:billing.refund.approved.v1",
  "title": "billing.refund.approved.v1",
  "description": "A refund request was approved: a credit note was issued and the money goes back by the listed payment methods.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "refundRequestId", "invoiceId", "amountMinor", "methods", "version"],
  "properties": {
    "tenantId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "refundRequestId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "invoiceId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "amountMinor": {"type": "integer", "minimum": 1},
    "methods": {"type": "array", "items": {"type": "string", "enum": ["cash", "card", "upi", "other"]}, "minItems": 1, "maxItems": 4},
    "version": {"type": "integer", "minimum": 1, "description": "Outbox id of this event: monotonic per aggregate."}
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "refundRequestId": "55555555-5555-4555-8555-555555555555",
      "invoiceId": "33333333-3333-4333-8333-333333333333",
      "amountMinor": 118000,
      "methods": ["cash"],
      "version": 1
    }
  ]
}
