{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:billing.payment.recorded.v1",
  "title": "billing.payment.recorded.v1",
  "description": "A payment was recorded against an invoice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "invoiceId",
    "paymentId",
    "method",
    "amountMinor",
    "currency",
    "balanceMinor",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "invoiceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "paymentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "method": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "amountMinor": {
      "type": "integer"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "balanceMinor": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "invoiceId": "33333333-3333-4333-8333-333333333333",
      "paymentId": "44444444-4444-4444-8444-444444444444",
      "method": "cash",
      "amountMinor": 10000,
      "currency": "INR",
      "balanceMinor": 40000,
      "status": "partially_paid",
      "version": 1
    }
  ]
}
