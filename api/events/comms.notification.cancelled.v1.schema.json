{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:comms.notification.cancelled.v1",
  "title": "comms.notification.cancelled.v1",
  "description": "A pending notification request no longer applies (COM-004).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "requestId",
    "reason",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "subject_changed",
        "consent_withdrawn"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "requestId": "55555555-5555-4555-8555-555555555555",
      "reason": "subject_changed",
      "version": 2
    }
  ]
}
