{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:engagement.recall.created.v1",
  "title": "engagement.recall.created.v1",
  "description": "A recall order was created (COM-052: the doctor set it at consult close). Read the recall for details.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "recallId",
    "patientId",
    "dueDate",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "recallId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "patientId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Clinic-local calendar date the patient is due back."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "recallId": "33333333-3333-4333-8333-333333333333",
      "patientId": "44444444-4444-4444-8444-444444444444",
      "dueDate": "2026-11-30",
      "version": 1
    }
  ]
}
