{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:clinical.drug_master.version_activated.v1",
  "title": "clinical.drug_master.version_activated.v1",
  "description": "A new regional drug master version became active (CLN-019). Counts only, no drug content. Published once per tenant of the region.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "region",
    "drugMasterVersion",
    "added",
    "changed",
    "retired",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "region": {
      "type": "string",
      "enum": [
        "IN",
        "AE",
        "SA",
        "QA"
      ]
    },
    "drugMasterVersion": {
      "type": "integer",
      "minimum": 1
    },
    "added": {
      "type": "integer",
      "minimum": 0
    },
    "changed": {
      "type": "integer",
      "minimum": 0
    },
    "retired": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "region": "IN",
      "drugMasterVersion": 3,
      "added": 120,
      "changed": 14,
      "retired": 2,
      "version": 1
    }
  ]
}
