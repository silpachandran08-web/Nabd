{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:organization.tenant.region_pinned.v1",
  "title": "organization.tenant.region_pinned.v1",
  "description": "A clinic went live and its region is now immutable (OPS-061). The control plane records the cell routing from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "regionCode",
    "cell",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "regionCode": {
      "type": "string",
      "enum": [
        "IN",
        "AE",
        "SA",
        "QA"
      ]
    },
    "cell": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,15}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "regionCode": "AE",
      "cell": "ae",
      "version": 1
    }
  ]
}
