{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:lab.catalogue.changed.v1",
  "title": "lab.catalogue.changed.v1",
  "description": "A test or a panel of the clinic's lab catalogue was added or updated. Ids only: consumers re-read the catalogue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "testId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The lab test that changed; absent when a panel changed."
    },
    "panelId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The lab panel that changed; absent when a test changed."
    },
    "status": {
      "type": "string",
      "enum": [
        "added",
        "updated"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "testId": "33333333-3333-4333-8333-333333333333",
      "status": "added",
      "version": 1
    }
  ]
}
