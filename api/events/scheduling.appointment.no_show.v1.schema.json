{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:scheduling.appointment.no_show.v1",
  "title": "scheduling.appointment.no_show.v1",
  "description": "A booking was marked as a no-show, by staff or by the grace-period job (ACC-025). Ids only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "appointmentId",
    "doctorId",
    "markedBy",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "appointmentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "doctorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "markedBy": {
      "type": "string",
      "enum": [
        "system",
        "staff"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "appointmentId": "33333333-3333-4333-8333-333333333333",
      "doctorId": "22222222-2222-4222-8222-222222222222",
      "markedBy": "system",
      "version": 1
    }
  ]
}
