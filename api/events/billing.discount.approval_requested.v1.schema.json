{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:billing.discount.approval_requested.v1",
  "title": "billing.discount.approval_requested.v1",
  "description": "A bill's discounts and below-list price overrides are above the owner's threshold and wait for the owner's approval (FIN-018). Amount is the total price reduction on the bill; percent is its share of the list-price subtotal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "approvalId", "amountMinor", "percent", "version"],
  "properties": {
    "tenantId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "approvalId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "amountMinor": {"type": "integer", "minimum": 1},
    "percent": {"type": "number", "minimum": 0, "maximum": 100},
    "version": {"type": "integer", "minimum": 1, "description": "Outbox id of this event: monotonic per aggregate."}
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "approvalId": "66666666-6666-4666-8666-666666666666",
      "amountMinor": 15000,
      "percent": 15.0,
      "version": 1
    }
  ]
}
