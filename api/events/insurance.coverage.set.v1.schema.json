{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:insurance.coverage.set.v1",
  "title": "insurance.coverage.set.v1",
  "description": "The desk marked a visit insured or self-pay. Ids and the mode only: consumers that need the policy or the payer read them through the insurance module.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "visitId",
    "mode",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "visitId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The visit (queue entry) the coverage decision is for."
    },
    "mode": {
      "type": "string",
      "enum": [
        "self_pay",
        "insured"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "visitId": "33333333-3333-4333-8333-333333333333",
      "mode": "insured",
      "version": 1
    }
  ]
}
