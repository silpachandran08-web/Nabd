{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:iam.break_glass.reviewed.v1",
  "title": "iam.break_glass.reviewed.v1",
  "description": "PLT-013: the owner recorded the review outcome of an ended break-glass (emergency access) grant. No note text, no patient data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "grantId",
    "outcome",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "grantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "justified",
        "not_justified"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "grantId": "22222222-2222-4222-8222-222222222222",
      "outcome": "not_justified",
      "version": 1
    }
  ]
}
