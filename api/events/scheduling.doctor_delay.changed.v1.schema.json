{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:scheduling.doctor_delay.changed.v1",
  "title": "scheduling.doctor_delay.changed.v1",
  "description": "A doctor's running-late delay was announced or cleared.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "doctorId",
    "delayId",
    "delayMinutes",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "doctorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "delayId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "delayMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 240
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cleared"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "doctorId": "22222222-2222-4222-8222-222222222222",
      "delayId": "33333333-3333-4333-8333-333333333333",
      "delayMinutes": 20,
      "status": "active",
      "version": 1
    }
  ]
}
