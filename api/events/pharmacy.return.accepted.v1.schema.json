{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:pharmacy.return.accepted.v1",
  "title": "pharmacy.return.accepted.v1",
  "description": "A customer's returned units went back into stock with an approved credit note (PHL-011): one line per batch the units entered. quarantined = the batch had expired since the sale, so the units are not sellable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "invoiceId",
    "creditId",
    "refundRequestId",
    "lines",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "invoiceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "creditId": {
      "type": "string",
      "description": "The credit note's id (named creditId: field names may not contain the PHI-denylist word 'note').",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "refundRequestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invoiceLineId", "batchId", "qty", "quarantined"],
        "properties": {
          "invoiceLineId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "batchId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "quarantined": {
            "type": "boolean"
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "invoiceId": "22222222-2222-4222-8222-222222222222",
      "creditId": "33333333-3333-4333-8333-333333333333",
      "refundRequestId": "55555555-5555-4555-8555-555555555555",
      "lines": [
        {"invoiceLineId": "66666666-6666-4666-8666-666666666666", "batchId": "44444444-4444-4444-8444-444444444444", "qty": 1, "quarantined": false}
      ],
      "version": 1
    }
  ]
}
