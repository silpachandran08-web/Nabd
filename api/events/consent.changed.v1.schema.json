{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:consent.changed.v1",
  "title": "consent.changed.v1",
  "description": "A patient consent was granted or withdrawn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "patientId",
    "consentType",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "patientId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "consentType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "withdrawn"
      ]
    },
    "noticeVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,40}$",
      "description": "IDC-004: the privacy notice version the decision was given under (absent for withdrawals and legacy rows)."
    },
    "guardianRef": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "IDC-004/008: the guardian patient who gave the consent for a minor."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "patientId": "44444444-4444-4444-8444-444444444444",
      "consentType": "messaging",
      "status": "withdrawn",
      "version": 1
    }
  ]
}
