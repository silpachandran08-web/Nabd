{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:comms.inbound.received.v1",
  "title": "comms.inbound.received.v1",
  "description": "A patient message reached the clinic's WhatsApp number (ids and kind only, never the text).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "inboundId",
    "kind",
    "receivedAt",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "inboundId": {
      "type": "integer",
      "minimum": 1,
      "description": "whatsapp_inbound_events.id of the stored delivery."
    },
    "senderNumberId": {
      "type": "string",
      "pattern": "^[0-9]{1,32}$",
      "description": "Meta id of the business number that received the message."
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "button",
        "interactive",
        "media",
        "location",
        "other"
      ]
    },
    "buttonPayload": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.: -]{1,64}$"
    },
    "replyToWamid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9=_.-]{1,128}$"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9T:.+Z-]{20,40}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    },
    "threadId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Inbox thread the message was filed in (COM-030)."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "inboundId": 42,
      "senderNumberId": "109876543210",
      "kind": "button",
      "buttonPayload": "STOP_PROMOTIONS",
      "replyToWamid": "wamid.HBgM1",
      "receivedAt": "2026-10-20T04:30:00Z",
      "version": 1
    }
  ]
}
