{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:clinical.allergy.changed.v1",
  "title": "clinical.allergy.changed.v1",
  "description": "A patient's allergy register changed. Read the register for details.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "patientId",
    "change",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "patientId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "allergyId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "change": {
      "type": "string",
      "enum": [
        "recorded",
        "corrected",
        "removed",
        "no_known_allergies"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "removed",
        "none_documented"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "patientId": "44444444-4444-4444-8444-444444444444",
      "allergyId": "33333333-3333-4333-8333-333333333333",
      "change": "recorded",
      "status": "active",
      "version": 1
    }
  ]
}
