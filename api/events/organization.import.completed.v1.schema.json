{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:organization.import.completed.v1",
  "title": "organization.import.completed.v1",
  "description": "A staged patient import (ADM-012) finished: counts only, never a name, number or file content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "jobId",
    "importType",
    "created",
    "merged",
    "skipped",
    "errors",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "importType": {
      "type": "string",
      "enum": [
        "patients"
      ]
    },
    "created": {
      "type": "integer",
      "minimum": 0
    },
    "merged": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "jobId": "22222222-2222-4222-8222-222222222222",
      "importType": "patients",
      "created": 9980,
      "merged": 0,
      "skipped": 14,
      "errors": 6,
      "version": 1
    }
  ]
}
