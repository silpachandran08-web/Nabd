{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:pharmacy.stock.alerts_digest_ready.v1",
  "title": "pharmacy.stock.alerts_digest_ready.v1",
  "description": "The clinic's daily stock-alert digest is ready for its one named recipient (pharmacy_settings.alert_recipient_staff_id): open alerts per bucket on that clinic day. Counts only, never an item, batch or patient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "recipientStaffId",
    "day",
    "counts",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "recipientStaffId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "day": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Clinic-local date of the digest."
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiry90", "expiry60", "expiry30", "expired", "low", "dead"],
      "properties": {
        "expiry90": {"type": "integer", "minimum": 0, "maximum": 1000000, "description": "Batches expiring in 61-90 days."},
        "expiry60": {"type": "integer", "minimum": 0, "maximum": 1000000, "description": "Batches expiring in 31-60 days."},
        "expiry30": {"type": "integer", "minimum": 0, "maximum": 1000000, "description": "Batches expiring within 30 days."},
        "expired": {"type": "integer", "minimum": 0, "maximum": 1000000, "description": "Batches past expiry still on hand."},
        "low": {"type": "integer", "minimum": 0, "maximum": 1000000, "description": "Items below their reorder level."},
        "dead": {"type": "integer", "minimum": 0, "maximum": 1000000, "description": "Items with stock and no outward movement in the dead-stock period."}
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "recipientStaffId": "22222222-2222-4222-8222-222222222222",
      "day": "2026-11-17",
      "counts": {"expiry90": 4, "expiry60": 2, "expiry30": 1, "expired": 0, "low": 3, "dead": 2},
      "version": 1
    }
  ]
}
