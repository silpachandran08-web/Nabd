{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:billing.invoice.paid.v1",
  "title": "billing.invoice.paid.v1",
  "description": "An invoice became fully paid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "invoiceId",
    "totalMinor",
    "currency",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "invoiceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "totalMinor": {
      "type": "integer"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "status": {
      "type": "string",
      "const": "paid"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "invoiceId": "33333333-3333-4333-8333-333333333333",
      "totalMinor": 50000,
      "currency": "INR",
      "status": "paid",
      "version": 1
    }
  ]
}
