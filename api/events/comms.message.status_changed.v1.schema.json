{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:comms.message.status_changed.v1",
  "title": "comms.message.status_changed.v1",
  "description": "A WhatsApp message was cancelled or expired before it was sent (COM-003). The envelope time is the moment of the change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "messageId",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "messageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": ["cancelled", "expired"]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "messageId": "55555555-5555-4555-8555-555555555555",
      "status": "cancelled",
      "version": 1
    }
  ]
}
