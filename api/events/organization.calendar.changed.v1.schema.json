{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:organization.calendar.changed.v1",
  "title": "organization.calendar.changed.v1",
  "description": "The clinic's holiday calendar changed: each date with the effect it now has (closed, short with its bookable windows, or open). Consumers re-read the calendar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "dates",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "effect"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "effect": {
            "type": "string",
            "enum": [
              "closed",
              "short",
              "open"
            ]
          },
          "hours": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "dates": [
        {
          "date": "2026-10-02",
          "effect": "short",
          "hours": [
            {
              "from": "09:00",
              "to": "13:00"
            }
          ]
        }
      ],
      "version": 1
    }
  ]
}
