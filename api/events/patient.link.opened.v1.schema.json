{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:patient.link.opened.v1",
  "title": "patient.link.opened.v1",
  "description": "A patient's secure link (prescription, invoice, report) was opened or refused. Outcome and device class only; never the address, document or OTP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "linkId",
    "patientId",
    "resourceType",
    "outcome",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "linkId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "patientId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "resourceType": {
      "type": "string",
      "pattern": "^[a-z_]{1,40}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "otp_ok",
        "otp_failed",
        "expired",
        "revoked"
      ]
    },
    "deviceFamily": {
      "type": "string",
      "enum": [
        "iPhone",
        "iPad",
        "Android phone",
        "Android tablet",
        "Windows",
        "Mac",
        "Linux",
        "ChromeOS",
        "Bot",
        "Other",
        "Unknown"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "linkId": "33333333-3333-4333-8333-333333333333",
      "patientId": "44444444-4444-4444-8444-444444444444",
      "resourceType": "rx",
      "outcome": "otp_ok",
      "deviceFamily": "Android phone",
      "version": 1
    }
  ]
}
