{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nabd:event-schema:shared.attachment.scanned.v1",
  "title": "shared.attachment.scanned.v1",
  "description": "An uploaded file finished the scan pipeline: available, or blocked (infected / rejected_type).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "fileId",
    "purpose",
    "status",
    "version"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "fileId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "outside_report",
        "clinical_photo",
        "xray",
        "consent_form"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "infected",
        "rejected_type"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Outbox id of this event: monotonic per aggregate."
    }
  },
  "examples": [
    {
      "tenantId": "11111111-1111-4111-8111-111111111111",
      "fileId": "55555555-5555-4555-8555-555555555555",
      "purpose": "outside_report",
      "status": "available",
      "version": 1
    }
  ]
}
